// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`App Health GET /api/health should answer the preflight of an origin of HTTP_CORS_ORIGINS 1`] = `
{
  "headers": {
    "access-control-allow-methods": "GET,HEAD,PUT,PATCH,POST,DELETE",
    "access-control-allow-origin": "https://app.example.test",
    "access-control-expose-headers": "x-correlation-id,Retry-After,Retry-After-auth",
  },
}
`;

exports[`App Health GET /api/health should report liveness and mint a correlation id 1`] = `
{
  "response": {
    "body": {
      "app": "processor-app",
      "status": "ok",
      "uptimeSeconds": Any<Number>,
    },
  },
}
`;

exports[`App Health GET /api/health should set the security headers of helmet 1`] = `
{
  "headers": {
    "content-security-policy": "default-src 'none';frame-ancestors 'none'",
    "strict-transport-security": "max-age=31536000; includeSubDomains",
    "x-content-type-options": "nosniff",
    "x-frame-options": "DENY",
    "x-powered-by": undefined,
  },
}
`;

exports[`App Health GET /api/health/ready should report readiness of the database and the cache 1`] = `
{
  "response": {
    "body": {
      "app": "processor-app",
      "dependencies": {
        "cache": {
          "latencyMs": Any<Number>,
          "status": "ok",
        },
        "database": {
          "latencyMs": Any<Number>,
          "status": "ok",
        },
      },
      "status": "ready",
    },
  },
}
`;

